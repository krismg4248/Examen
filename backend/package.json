{
  "name": "refaccionaria-backend",
  "version": "1.0.0",
  "description": "API NestJS de administracion para refaccionaria (Supabase + bcrypt)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node --use-system-ca ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --use-system-ca ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node --use-system-ca dist/main",
    "seed": "node --use-system-ca scripts/seed.js",
    "setup-db": "node --use-system-ca scripts/setup-db.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@supabase/supabase-js": "^2.49.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.7.0"
  }
}
